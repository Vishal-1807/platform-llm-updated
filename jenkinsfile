pipeline {
    agent any
    
    tools {
        nodejs 'Node_18'
    }
    
    environment {
        AZURE_CLIENT_ID       = credentials('azure-sp-client-id')
        AZURE_CLIENT_SECRET   = credentials('azure-sp-client-secret')
        AZURE_TENANT_ID       = credentials('azure-sp-tenant-id')
        AZURE_SUBSCRIPTION_ID = credentials('azure-subscription-id')
        AZURE_STORAGE_ACCOUNT = credentials('AZURE_STORAGE_ACCOUNT')
        AZURE_RESOURCE_GROUP  = credentials('AKS_RESOURCE_GROUP')  
        STORAGE_CONTAINER     = '$web'
    }
    
    stages {
        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }
        
        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }
        
        stage('Test') {
            steps {
                sh 'npm test'
            }
        }
        
        stage('Azure Upload') {
            steps {
                script {
                    sh '''
                        # Login to Azure
                        az login --service-principal \
                            -u ${AZURE_CLIENT_ID} \
                            -p ${AZURE_CLIENT_SECRET} \
                            --tenant ${AZURE_TENANT_ID}
                        
                        az account set --subscription ${AZURE_SUBSCRIPTION_ID}
                        
                        # Get storage account key
                        echo "Getting storage account key..."
                        STORAGE_KEY=$(az storage account keys list \
                            --account-name ${AZURE_STORAGE_ACCOUNT} \
                            --resource-group ${AZURE_RESOURCE_GROUP} \
                            --query '[0].value' \
                            --output tsv)
                        
                        echo "Storage Key retrieved successfully"
                        
                        # Method 1: Try direct upload first
                        echo "Attempting Method 1: Direct upload..."
                        if az storage blob upload-batch \
                            --account-name "${AZURE_STORAGE_ACCOUNT}" \
                            --account-key "${STORAGE_KEY}" \
                            --destination '\\$web' \
                            --source "./dist" \
                            --overwrite; then
                            
                            echo " Upload successful using Method 1"
                            exit 0
                        fi
                        
                        echo "Method 1 failed, trying Method 2..."
                        
                        # Method 2: Try with different container name format
                        if az storage blob upload-batch \
                            --account-name "${AZURE_STORAGE_ACCOUNT}" \
                            --account-key "${STORAGE_KEY}" \
                            --destination "\\\$web" \
                            --source "./dist" \
                            --overwrite; then
                            
                            echo " Upload successful using Method 2"
                            exit 0
                        fi
                        
                        echo "Method 2 failed, trying Method 3..."
                        
                        # Method 3: Use Azure AD authentication
                        if az storage blob upload-batch \
                            --account-name "${AZURE_STORAGE_ACCOUNT}" \
                            --auth-mode login \
                            --destination '\\$web' \
                            --source "./dist" \
                            --overwrite; then
                            
                            echo " Upload successful using Method 3"
                            exit 0
                        fi
                        
                        echo "All methods failed. Checking network connectivity..."
                        
                        # Network diagnostics
                        echo "=== Network Diagnostics ==="
                        nslookup google.com || echo "DNS resolution failed"
                        curl -I https://microsoft.com || echo "HTTPS connectivity failed"
                        
                        echo " All upload methods failed. Please check network connectivity."
                        exit 1
                    '''
                }
            }
        }
    }
    
    post {
        always {
            sh 'az logout || true'
        }
    }
}
