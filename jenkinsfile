pipeline {
    agent any
    
    tools {
        nodejs 'Node_18'
    }
    
    environment {
        AZURE_CLIENT_ID       = credentials('azure-sp-client-id')
        AZURE_CLIENT_SECRET   = credentials('azure-sp-client-secret')
        AZURE_TENANT_ID       = credentials('azure-sp-tenant-id')
        AZURE_SUBSCRIPTION_ID = credentials('azure-subscription-id')
        AZURE_STORAGE_ACCOUNT = 'awonefrontendstatic12312'
        AZURE_RESOURCE_GROUP  = 'your-resource-group'
        STORAGE_CONTAINER     = '$web'
    }
    
    stages {
        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }
        
        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }
        
        stage('Test') {
            steps {
                sh 'npm test'
            }
        }
        
        stage('Azure Login') {
            steps {
                script {
                    sh '''
                        az login --service-principal \
                            -u ${AZURE_CLIENT_ID} \
                            -p ${AZURE_CLIENT_SECRET} \
                            --tenant ${AZURE_TENANT_ID}
                        
                        az account set --subscription ${AZURE_SUBSCRIPTION_ID}
                        
                        # Verify login and permissions
                        echo "=== Checking Azure Authentication ==="
                        az account show
                        
                        echo "=== Checking Storage Account Access ==="
                        az storage account show \
                            --name ${AZURE_STORAGE_ACCOUNT} \
                            --resource-group ${AZURE_RESOURCE_GROUP}
                    '''
                }
            }
        }
        
        stage('Verify Permissions') {
            steps {
                script {
                    sh '''
                        echo "=== Checking Role Assignments ==="
                        # List role assignments for the storage account
                        az role assignment list \
                            --scope "/subscriptions/${AZURE_SUBSCRIPTION_ID}/resourceGroups/${AZURE_RESOURCE_GROUP}/providers/Microsoft.Storage/storageAccounts/${AZURE_STORAGE_ACCOUNT}" \
                            --output table || true
                        
                        echo "=== Testing Container Access ==="
                        # Test if we can list containers (basic read permission test)
                        az storage container list \
                            --account-name ${AZURE_STORAGE_ACCOUNT} \
                            --auth-mode login || echo "Cannot list containers - permissions issue"
                    '''
                }
            }
        }
        
        stage('Upload to Azure Storage') {
            steps {
                script {
                    sh '''
                        echo "Starting upload to Azure Storage..."
                        az storage blob upload-batch \
                            --account-name ${AZURE_STORAGE_ACCOUNT} \
                            --auth-mode login \
                            --destination ${STORAGE_CONTAINER} \
                            --source ./dist \
                            --overwrite
                        
                        echo "Files uploaded successfully to Azure Storage Static Website"
                    '''
                }
            }
        }
    }
    
    post {
        success {
            echo 'Deployment to Azure Storage completed successfully!'
        }
        failure {
            echo 'Deployment failed. Please check the logs.'
        }
        always {
            sh 'az logout || true'
        }
    }
}
